<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:flowable="http://flowable.org/bpmn"
             targetNamespace="http://example.com/sil">

  <!--
    VOIP service order fulfilment, modelled as a saga.

    Two structural decisions carry the whole file.

    1. Every service task is flowable:async="true". An async task is a row in ACT_RU_JOB: the engine
       commits the state reached so far, then a job executor thread picks the task up in a
       transaction of its own. So each supplier call has its own transaction boundary and its own
       retry counter (failedJobRetryTimeCycle), and retries survive a restart of this application -
       the one thing an in-process retry loop can never do.

    2. Provisioning lives inside a <transaction> subprocess. A database transaction cannot roll back
       a customer that now exists in the supplier's system; the only way back is to call the
       supplier again and undo it. A BPMN transaction gives that a shape: reaching a cancel end
       event inside it triggers the compensation handlers of every activity that completed, in
       reverse order, and only then does the cancel boundary event outside fire.

       The alternative - unwinding by hand in a catch block - has to answer "how far did we get?"
       at every failure point. Here the engine already knows, because it recorded each completed
       activity as it happened.

    The three ways in: the supplier rejects the activation, the SLA expires, or the client cancels.
    All three converge on a cancel end event, so there is exactly one unwind path to reason about.
  -->
  <process id="serviceOrder" name="VOIP Service Order Fulfilment" isExecutable="true">

    <startEvent id="orderSubmitted" name="Order submitted"/>
    <sequenceFlow id="toFulfilment" sourceRef="orderSubmitted" targetRef="fulfilment"/>

    <transaction id="fulfilment" name="Provision service">

      <startEvent id="fulfilmentStarted"/>
      <sequenceFlow id="toCreateCustomer" sourceRef="fulfilmentStarted" targetRef="createCustomer"/>

      <serviceTask id="createCustomer" name="Create customer"
                   flowable:async="true"
                   flowable:failedJobRetryTimeCycle="R3/PT10S"
                   flowable:delegateExpression="${createCustomerDelegate}"/>
      <boundaryEvent id="compensateCreateCustomer" attachedToRef="createCustomer">
        <compensateEventDefinition/>
      </boundaryEvent>
      <serviceTask id="undoCreateCustomer" name="Delete customer" isForCompensation="true"
                   flowable:delegateExpression="${deleteCustomerDelegate}"/>
      <sequenceFlow id="createCustomerToCheck" sourceRef="createCustomer" targetRef="afterCustomer"/>
      <exclusiveGateway id="afterCustomer" name="Cancelled?"/>
      <sequenceFlow id="afterCustomerContinue" sourceRef="afterCustomer" targetRef="createSubscription">
        <conditionExpression xsi:type="tFormalExpression">${!cancellationRequested}</conditionExpression>
      </sequenceFlow>
      <sequenceFlow id="afterCustomerCancel" sourceRef="afterCustomer" targetRef="recordCancellation">
        <conditionExpression xsi:type="tFormalExpression">${cancellationRequested}</conditionExpression>
      </sequenceFlow>

      <serviceTask id="createSubscription" name="Create subscription"
                   flowable:async="true"
                   flowable:failedJobRetryTimeCycle="R3/PT10S"
                   flowable:delegateExpression="${createSubscriptionDelegate}"/>
      <boundaryEvent id="compensateCreateSubscription" attachedToRef="createSubscription">
        <compensateEventDefinition/>
      </boundaryEvent>
      <serviceTask id="undoCreateSubscription" name="Delete subscription" isForCompensation="true"
                   flowable:delegateExpression="${deleteSubscriptionDelegate}"/>
      <sequenceFlow id="createSubscriptionToCheck" sourceRef="createSubscription" targetRef="afterSubscription"/>
      <exclusiveGateway id="afterSubscription" name="Cancelled?"/>
      <sequenceFlow id="afterSubscriptionContinue" sourceRef="afterSubscription" targetRef="createUser">
        <conditionExpression xsi:type="tFormalExpression">${!cancellationRequested}</conditionExpression>
      </sequenceFlow>
      <sequenceFlow id="afterSubscriptionCancel" sourceRef="afterSubscription" targetRef="recordCancellation">
        <conditionExpression xsi:type="tFormalExpression">${cancellationRequested}</conditionExpression>
      </sequenceFlow>

      <serviceTask id="createUser" name="Create user"
                   flowable:async="true"
                   flowable:failedJobRetryTimeCycle="R3/PT10S"
                   flowable:delegateExpression="${createUserDelegate}"/>
      <boundaryEvent id="compensateCreateUser" attachedToRef="createUser">
        <compensateEventDefinition/>
      </boundaryEvent>
      <serviceTask id="undoCreateUser" name="Delete user" isForCompensation="true"
                   flowable:delegateExpression="${deleteUserDelegate}"/>
      <sequenceFlow id="createUserToCheck" sourceRef="createUser" targetRef="afterUser"/>
      <exclusiveGateway id="afterUser" name="Cancelled?"/>
      <sequenceFlow id="afterUserContinue" sourceRef="afterUser" targetRef="reserveNumber">
        <conditionExpression xsi:type="tFormalExpression">${!cancellationRequested}</conditionExpression>
      </sequenceFlow>
      <sequenceFlow id="afterUserCancel" sourceRef="afterUser" targetRef="recordCancellation">
        <conditionExpression xsi:type="tFormalExpression">${cancellationRequested}</conditionExpression>
      </sequenceFlow>

      <serviceTask id="reserveNumber" name="Reserve phone number"
                   flowable:async="true"
                   flowable:failedJobRetryTimeCycle="R3/PT10S"
                   flowable:delegateExpression="${reserveNumberDelegate}"/>
      <boundaryEvent id="compensateReserveNumber" attachedToRef="reserveNumber">
        <compensateEventDefinition/>
      </boundaryEvent>
      <serviceTask id="undoReserveNumber" name="Release phone number" isForCompensation="true"
                   flowable:delegateExpression="${releaseNumberDelegate}"/>
      <sequenceFlow id="reserveNumberToCheck" sourceRef="reserveNumber" targetRef="afterNumber"/>
      <exclusiveGateway id="afterNumber" name="Cancelled?"/>
      <sequenceFlow id="afterNumberContinue" sourceRef="afterNumber" targetRef="requestActivation">
        <conditionExpression xsi:type="tFormalExpression">${!cancellationRequested}</conditionExpression>
      </sequenceFlow>
      <sequenceFlow id="afterNumberCancel" sourceRef="afterNumber" targetRef="recordCancellation">
        <conditionExpression xsi:type="tFormalExpression">${cancellationRequested}</conditionExpression>
      </sequenceFlow>

      <!--
        The supplier can reject an activation outright - the number is already ported, the address
        does not match. That is a business answer, not a technical fault, so the delegate raises a
        BPMN error instead of throwing. The difference decides everything downstream: an exception
        means "try again, this might work", a BPMN error means "this will never work, unwind".
      -->
      <serviceTask id="requestActivation" name="Request number activation"
                   flowable:async="true"
                   flowable:failedJobRetryTimeCycle="R3/PT10S"
                   flowable:delegateExpression="${requestActivationDelegate}"/>
      <!--
        Declaration order matters here, and only here. Flowable resolves an error to a handler by
        walking this activity's boundary events in document order, and a compensation boundary
        event encountered first makes that walk fail with "Parent activity for boundary
        compensation event could not be found" - the rejection never reaches its handler at all.
        Verified by swapping the two back and watching every compensation test fail.
      -->
      <boundaryEvent id="activationRejected" name="Rejected by supplier" attachedToRef="requestActivation">
        <errorEventDefinition errorRef="SUPPLIER_REJECTED"/>
      </boundaryEvent>
      <boundaryEvent id="compensateRequestActivation" attachedToRef="requestActivation">
        <compensateEventDefinition/>
      </boundaryEvent>
      <serviceTask id="undoRequestActivation" name="Cancel activation" isForCompensation="true"
                   flowable:delegateExpression="${cancelActivationDelegate}"/>
      <sequenceFlow id="rejectedToCancel" sourceRef="activationRejected" targetRef="fulfilmentCancelled"/>
      <sequenceFlow id="toAwaitActivation" sourceRef="requestActivation" targetRef="awaitActivation"/>

      <!--
        Waiting for the supplier's callback. Wrapped in a subprocess purely so timers can be
        attached: boundary events attach to activities, and a bare message catch event is not one.
      -->
      <subProcess id="awaitActivation" name="Await activation callback">
        <startEvent id="waitStarted"/>
        <sequenceFlow id="waitToMessage" sourceRef="waitStarted" targetRef="activationCallback"/>
        <intermediateCatchEvent id="activationCallback" name="Number activated">
          <messageEventDefinition messageRef="numberActivated"/>
        </intermediateCatchEvent>
        <sequenceFlow id="messageToWaitEnd" sourceRef="activationCallback" targetRef="waitEnded"/>
        <endEvent id="waitEnded"/>
      </subProcess>

      <!--
        Interrupting: the supplier promised an answer within the SLA and did not deliver one. A
        stuck order nobody notices is worse than a failed one somebody does.
      -->
      <boundaryEvent id="activationSlaBreached" name="Activation SLA breached"
                     attachedToRef="awaitActivation" cancelActivity="true">
        <timerEventDefinition>
          <timeDuration>PT2H</timeDuration>
        </timerEventDefinition>
      </boundaryEvent>
      <sequenceFlow id="slaToTimeout" sourceRef="activationSlaBreached" targetRef="activationTimedOut"/>
      <serviceTask id="activationTimedOut" name="Record activation timeout"
                   flowable:async="true"
                   flowable:delegateExpression="${activationTimedOutDelegate}"/>
      <sequenceFlow id="timeoutToCancel" sourceRef="activationTimedOut" targetRef="fulfilmentCancelled"/>

      <!--
        Non-interrupting and repeating: keep the customer informed while we wait.
        cancelActivity="false" is what makes this a side effect rather than a detour - the token
        stays on the wait, so the callback can still arrive.
      -->
      <boundaryEvent id="activationReminder" name="Remind customer"
                     attachedToRef="awaitActivation" cancelActivity="false">
        <timerEventDefinition>
          <timeCycle>R3/PT30M</timeCycle>
        </timerEventDefinition>
      </boundaryEvent>
      <sequenceFlow id="reminderToSend" sourceRef="activationReminder" targetRef="sendReminder"/>
      <serviceTask id="sendReminder" name="Send progress reminder"
                   flowable:async="true"
                   flowable:delegateExpression="${sendReminderDelegate}"/>
      <sequenceFlow id="reminderToEnd" sourceRef="sendReminder" targetRef="reminderSent"/>
      <endEvent id="reminderSent" name="Reminder sent"/>

      <sequenceFlow id="toShipHardware" sourceRef="awaitActivation" targetRef="shipHardware"/>

      <serviceTask id="shipHardware" name="Ship hardware"
                   flowable:async="true"
                   flowable:failedJobRetryTimeCycle="R3/PT10S"
                   flowable:delegateExpression="${shipHardwareDelegate}"/>
      <boundaryEvent id="compensateShipHardware" attachedToRef="shipHardware">
        <compensateEventDefinition/>
      </boundaryEvent>
      <serviceTask id="undoShipHardware" name="Cancel shipment" isForCompensation="true"
                   flowable:delegateExpression="${cancelShipmentDelegate}"/>
      <sequenceFlow id="shipHardwareToCheck" sourceRef="shipHardware" targetRef="afterShipment"/>
      <exclusiveGateway id="afterShipment" name="Cancelled?"/>
      <sequenceFlow id="afterShipmentContinue" sourceRef="afterShipment" targetRef="awaitDelivery">
        <conditionExpression xsi:type="tFormalExpression">${!cancellationRequested}</conditionExpression>
      </sequenceFlow>
      <sequenceFlow id="afterShipmentCancel" sourceRef="afterShipment" targetRef="recordCancellation">
        <conditionExpression xsi:type="tFormalExpression">${cancellationRequested}</conditionExpression>
      </sequenceFlow>

      <!--
        Poll loop, wrapped in a subprocess so that a cancellation boundary event has something to
        attach to. Shipping takes days to weeks and the supplier offers no callback for it, so the
        process sleeps on a timer and asks again. While asleep it costs one row in ACT_RU_TIMER_JOB
        - no thread, no memory - and it resumes after a restart.
      -->
      <subProcess id="awaitDelivery" name="Await delivery">
        <startEvent id="deliveryWaitStarted"/>
        <sequenceFlow id="toWaitBeforePollingInner" sourceRef="deliveryWaitStarted" targetRef="waitBeforePolling"/>

        <intermediateCatchEvent id="waitBeforePolling" name="Wait before polling">
          <timerEventDefinition>
            <timeDuration>${shipmentPollDelay}</timeDuration>
          </timerEventDefinition>
        </intermediateCatchEvent>
        <sequenceFlow id="toPollShipment" sourceRef="waitBeforePolling" targetRef="pollShipment"/>

        <serviceTask id="pollShipment" name="Poll shipment status"
                     flowable:async="true"
                     flowable:failedJobRetryTimeCycle="R3/PT10S"
                     flowable:delegateExpression="${pollShipmentDelegate}"/>
        <sequenceFlow id="toDeliveredGateway" sourceRef="pollShipment" targetRef="deliveredGateway"/>

        <exclusiveGateway id="deliveredGateway" name="Delivered?"/>
        <sequenceFlow id="notDeliveredYet" sourceRef="deliveredGateway" targetRef="waitBeforePolling">
          <conditionExpression xsi:type="tFormalExpression">${!shipmentDelivered}</conditionExpression>
        </sequenceFlow>
        <sequenceFlow id="deliveredToDeliveryEnd" sourceRef="deliveredGateway" targetRef="delivered">
          <conditionExpression xsi:type="tFormalExpression">${shipmentDelivered}</conditionExpression>
        </sequenceFlow>
        <endEvent id="delivered"/>
      </subProcess>
      <sequenceFlow id="toProvisioned" sourceRef="awaitDelivery" targetRef="provisioned"/>

      <endEvent id="provisioned" name="Service provisioned"/>

      <!--
        Cancellation by the client, handled in two complementary ways so that it can be requested at
        any moment and still unwind cleanly.

        The checkpoints above are the general mechanism: the intent is recorded on the order, every
        step republishes it as a variable, and the gateway after each step routes to the unwind. A
        cancellation arriving mid-provisioning is honoured at the next step boundary rather than
        refused.

        The boundary events below are the impatient half: while the order is parked waiting for a
        callback or a handset, the next checkpoint could be a fortnight away, so the wait is
        interrupted directly.

        What neither does is put a boundary event on the transaction itself. That is simpler to draw
        and useless in practice - interrupting the transaction destroys the compensation
        subscriptions along with the scope, so the unwind would find nothing to undo.
      -->
      <boundaryEvent id="cancelDuringActivation" name="Cancelled during activation"
                     attachedToRef="awaitActivation" cancelActivity="true">
        <messageEventDefinition messageRef="cancelOrder"/>
      </boundaryEvent>
      <sequenceFlow id="cancelActivationToRecord" sourceRef="cancelDuringActivation" targetRef="recordCancellation"/>

      <boundaryEvent id="cancelDuringDelivery" name="Cancelled during delivery"
                     attachedToRef="awaitDelivery" cancelActivity="true">
        <messageEventDefinition messageRef="cancelOrder"/>
      </boundaryEvent>
      <sequenceFlow id="cancelDeliveryToRecord" sourceRef="cancelDuringDelivery" targetRef="recordCancellation"/>

      <serviceTask id="recordCancellation" name="Record cancellation request"
                   flowable:async="true"
                   flowable:delegateExpression="${recordCancellationDelegate}"/>
      <sequenceFlow id="recordCancellationToCancel" sourceRef="recordCancellation" targetRef="fulfilmentCancelled"/>

      <!--
        The cancel end event: reaching it unwinds the transaction. Every completed activity above
        has its compensation handler invoked, newest first, and only then does the cancel boundary
        event outside this transaction fire.
      -->
      <endEvent id="fulfilmentCancelled" name="Fulfilment cancelled">
        <cancelEventDefinition/>
      </endEvent>


      <!--
        Compensation handlers are deliberately NOT flowable:async. Marking them async stops the
        unwind happening at all - the transaction tears down before the queued handler jobs run,
        and nothing is undone. Synchronous handlers also give the unwind its ordering guarantee:
        the whole reverse sequence runs inside the single job that reached the cancel end event.

        The retry story comes from that job. If one undo fails, the job fails and is retried, which
        re-runs the handlers from the beginning - so every handler has to be idempotent.

        And idempotent at the supplier, not just here. Each handler clears the reference it undid
        and no-ops when it is already gone, but that bookkeeping is rolled back along with the
        failed job, while the DELETE it already sent is not. A retry therefore asks the supplier to
        undo something it has already undone. CompensationRetryTest pins both halves down.
      -->

      <!--
        Associations bind each compensation boundary event to its handler. They live down here
        rather than beside the tasks they belong to because the BPMN schema classifies them as
        artifacts, and artifacts must follow every flow element in their container.
        They must also stay inside the transaction: Flowable resolves a compensation handler
        through the association in the same scope as the boundary event, so moving them up to
        process level leaves the subscriptions in place but silently unbound - compensation
        then runs and does nothing at all.
      -->
      <association id="assocCustomer" associationDirection="One"
                   sourceRef="compensateCreateCustomer" targetRef="undoCreateCustomer"/>
      <association id="assocSubscription" associationDirection="One"
                   sourceRef="compensateCreateSubscription" targetRef="undoCreateSubscription"/>
      <association id="assocUser" associationDirection="One"
                   sourceRef="compensateCreateUser" targetRef="undoCreateUser"/>
      <association id="assocNumber" associationDirection="One"
                   sourceRef="compensateReserveNumber" targetRef="undoReserveNumber"/>
      <association id="assocActivation" associationDirection="One"
                   sourceRef="compensateRequestActivation" targetRef="undoRequestActivation"/>
      <association id="assocShipment" associationDirection="One"
                   sourceRef="compensateShipHardware" targetRef="undoShipHardware"/>
    </transaction>

    <sequenceFlow id="toCompleteOrder" sourceRef="fulfilment" targetRef="completeOrder"/>
    <serviceTask id="completeOrder" name="Complete order"
                 flowable:async="true"
                 flowable:delegateExpression="${completeOrderDelegate}"/>
    <sequenceFlow id="toOrderCompleted" sourceRef="completeOrder" targetRef="orderCompleted"/>
    <endEvent id="orderCompleted" name="Order completed"/>

    <!--
      Fires once the transaction has unwound itself, which happens only after every compensation
      handler inside it has run. Both internal failure routes - a supplier rejection and a breached
      SLA - arrive here.
    -->
    <boundaryEvent id="fulfilmentUnwound" name="Fulfilment unwound" attachedToRef="fulfilment">
      <cancelEventDefinition/>
    </boundaryEvent>
    <sequenceFlow id="unwoundToOutcome" sourceRef="fulfilmentUnwound" targetRef="outcomeGateway"/>

    <!--
      All three unwind routes arrive at the same boundary event, and by then the cause is no longer
      on the stack - so it has to have been written down as a variable while it still was.
    -->
    <exclusiveGateway id="outcomeGateway" name="Cancelled by client?"/>
    <sequenceFlow id="outcomeToCancelled" sourceRef="outcomeGateway" targetRef="cancelOrderTask">
      <conditionExpression xsi:type="tFormalExpression">${cancelledByClient}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="outcomeToFailed" sourceRef="outcomeGateway" targetRef="failOrder">
      <conditionExpression xsi:type="tFormalExpression">${!cancelledByClient}</conditionExpression>
    </sequenceFlow>

    <serviceTask id="cancelOrderTask" name="Cancel order"
                 flowable:async="true"
                 flowable:delegateExpression="${cancelOrderDelegate}"/>
    <sequenceFlow id="toOrderCancelled" sourceRef="cancelOrderTask" targetRef="orderCancelled"/>
    <endEvent id="orderCancelled" name="Order cancelled"/>

    <serviceTask id="failOrder" name="Fail order"
                 flowable:async="true"
                 flowable:delegateExpression="${failOrderDelegate}"/>
    <sequenceFlow id="toOrderFailed" sourceRef="failOrder" targetRef="orderFailed"/>
    <endEvent id="orderFailed" name="Order failed"/>
  </process>

  <message id="numberActivated" name="numberActivated"/>
  <message id="cancelOrder" name="cancelOrder"/>
  <error id="SUPPLIER_REJECTED" errorCode="SUPPLIER_REJECTED"/>
</definitions>
