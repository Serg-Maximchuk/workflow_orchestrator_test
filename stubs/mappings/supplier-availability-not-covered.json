{
  "name": "Availability check - postcode outside the footprint",
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/supplier/v1/availability",
    "bodyPatterns": [
      { "matchesJsonPath": "$.[?(@.postcode == 'ZZ99 9ZZ')]" }
    ]
  },
  "response": {
    "status": 200,
    "headers": { "Content-Type": "application/json" },
    "jsonBody": {
      "available": false,
      "offeredServiceSpecIds": [],
      "maxSpeedMbps": 0
    }
  }
}
